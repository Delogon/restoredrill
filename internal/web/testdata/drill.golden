<div class="trend"><span class="trend-label">Duration</span> <svg class="spark" viewBox="0 0 120 32" width="120" height="32" role="img" aria-label="trend"><polyline points="0.0,30.0 120.0,30.0"/></svg></div>
</div>
</section>

<section>
