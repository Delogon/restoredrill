<nav class="pager">


</nav>
</section>

<section>
<h2>Resolved configuration <span class="muted small">(secrets redacted)</span></h2>
<pre class="config">drill:
    repository: r
    schedule: 30 4 * * *
    snapshot:
        select: latest
    restore:
        paths:
            - /srv/app
    checks:
        - type: files_exist
          paths:
            - srv/app
repository:
    type: restic
    repository: /var/backups/restic-repo
    no_lock: false
    env: {}
    password_file: /run/secrets/repo.pass
    password_command: &#34;&#34;
    password: &#34;&#34;
    passcommand: &#34;&#34;
    passphrase: &#34;&#34;
</pre>
</section>

</main>
